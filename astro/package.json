    "@iconify-json/material-symbols": "^1.2.90",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.10",
    "astro-mermaid": "^2.1.0",
    "astro-opengraph-images": "^1.20.1",
    "astro-redirect-from": "^1.3.5",
    "astro-rehype-relative-markdown-links": "^0.19.2",
