    "rehype-external-links": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-giscus": "^1.2.0",
    "starlight-heading-badges": "^0.8.0",
    "starlight-links-validator": "^0.25.3",
