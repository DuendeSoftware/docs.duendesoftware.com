---
import { getImagePath } from "astro-opengraph-images";
import { Font } from "astro:assets";
import VersionSelector from "./VersionSelector.astro";
import Default from "@astrojs/starlight/components/Head.astro";

const { url, site } = Astro;
const openGraphImageUrl = getImagePath({ url, site });
---

<Default />
<VersionSelector />
{openGraphImageUrl && <meta property="og:image" content={openGraphImageUrl} />}
<Font cssVariable="--font-funnel-sans" preload={true} />
<Font cssVariable="--font-gt-canon" preload={true} />
