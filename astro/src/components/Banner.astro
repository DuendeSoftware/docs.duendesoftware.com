---
import global from "../data/banner.json" with { type: "json" };
let { banner } = Astro.locals.starlightRoute.entry.data;

// no banner on page
if (!banner) {
  // check the global banner
  if (global.content) {
    banner = global;
  }
}
---

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

{banner && (
  <script is:inline>
    (function initBanner() {
      const banner = document.querySelector('.sl-banner');
      if (!banner) return;
      document.body.prepend(banner);
      const update = () => document.documentElement.style.setProperty('--sl-banner-height', banner.offsetHeight + 'px');
      update();
      // also covers resize and web-font swaps
      new ResizeObserver(update).observe(banner);
      document.addEventListener('astro:after-swap', initBanner, { once: true });
    })();
  </script>
)}

<style>
  .sl-banner {
    --__sl-banner-text: var(
      --sl-color-banner-text,
      var(--sl-color-text-invert)
    );
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    padding: 12px 24px;
    background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
    color: var(--__sl-banner-text);
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
    box-shadow: var(--sl-shadow-sm);
  }
  .sl-banner :global(a) {
    color: var(--__sl-banner-text);
  }
</style>

<style is:global>
  :root {
    --sl-banner-height: 0px;
  }
  /* first-paint estimate (single line); the script sets the exact value */
  :root:has(.sl-banner) {
    --sl-banner-height: calc(24px + 1.4em);
  }
  @media (max-width: 64rem) {
    :root:has(.sl-banner) {
      --sl-banner-height: calc(24px + 2.8em);
    }
  }
  header.header {
    top: var(--sl-banner-height) !important;
  }
  .sidebar-pane {
    top: calc(var(--sl-nav-height) + var(--sl-banner-height)) !important;
  }
  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + var(--sl-banner-height)) !important;
  }
  @media (min-width: 72rem) {
    .right-sidebar {
      padding-top: calc(var(--sl-nav-height) + var(--sl-banner-height)) !important;
    }
  }
  .sl-menu-button {
    top: calc(var(--sl-banner-height) + (var(--sl-nav-height) - var(--sl-menu-button-size)) / 2) !important;
  }
  mobile-starlight-toc nav {
    top: calc(var(--sl-nav-height) + var(--sl-banner-height) - 1px) !important;
  }
</style>
