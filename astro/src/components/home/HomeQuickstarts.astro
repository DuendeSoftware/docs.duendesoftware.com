---
import { Icon } from "@astrojs/starlight/components";

const steps = [
  {
    href: "/identityserver/quickstarts/1-client-credentials/",
    title: "Protect an API with client credentials",
    detail: "Machine-to-machine access: your first client, scope, and API.",
  },
  {
    href: "/identityserver/quickstarts/2-interactive/",
    title: "Add interactive sign-in to an ASP.NET Core app",
    detail: "OpenID Connect login and logout with a browser-based client.",
  },
  {
    href: "/identityserver/quickstarts/3-api-access/",
    title: "Call the API on behalf of the signed-in user",
    detail: "Combine sign-in with access tokens for API calls.",
  },
];
---

<div class="home-quickstarts not-content">
  <ol>
    {steps.map((step) => (
      <li>
        <a href={step.href}>
          <span class="text">
            <span class="title">{step.title}&nbsp;<Icon name="right-arrow" class="arrow" /></span>
            <span class="detail">{step.detail}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <p class="more">
    Then go further with Entity Framework Core, ASP.NET Core Identity, Blazor, and MCP in the{" "}
    <a href="/identityserver/quickstarts/0-overview/">full quickstart series</a>.
  </p>
</div>

<style>
  ol {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0 -0.5rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  li {
    margin: 0;
    counter-increment: step;
  }
  a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.5rem;
    border-radius: 0.375rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Step number: same green status dot language, as a numbered tile. */
  a::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--duende-color-green-800);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  a:hover {
    background-color: var(--dv-active-bg, var(--home-surface));
  }
  a:hover::before {
    background-color: var(--duende-color-green);
    border-color: var(--duende-color-green);
    color: #212121;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .title {
    font-weight: 600;
    line-height: 1.35;
    color: var(--sl-color-white);
    text-wrap: pretty;
  }
  .detail {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  :global(.home-quickstarts .arrow) {
    display: inline-block;
    vertical-align: -0.125em;
    color: var(--sl-color-text-accent);
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  a:hover :global(.arrow) {
    transform: translateX(3px);
  }
  .more {
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .more a {
    display: inline;
    padding: 0;
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .more a::before {
    content: none;
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    a::before,
    :global(.home-quickstarts .arrow) {
      transition: none;
    }
  }
</style>
