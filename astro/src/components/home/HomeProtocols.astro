---
import { Icon } from "@astrojs/starlight/components";

const steps = [
  {
    href: "/protocols/basics/which-oauth-flow/",
    icon: "random",
    title: "Choose the Right OAuth Flow",
    detail: "Authorization code with PKCE, client credentials, or the device grant: which one fits your app.",
  },
  {
    href: "/protocols/oauth-2x-core/pkce/",
    icon: "approve-check",
    title: "Authorization Code Flow with PKCE",
    detail: "Every message between the app and the authorization server, with the spec section for each.",
  },
  {
    href: "/protocols/basics/token-types/",
    icon: "document",
    title: "Access Token vs ID Token vs Refresh Token",
    detail: "What each token is for, who receives it, and who it is meant to be read by.",
  },
];
---

<div class="home-protocols not-content">
  <ul>
    {steps.map((step) => (
      <li>
        <a href={step.href}>
          <span class="badge"><Icon name={step.icon} size="1rem" /></span>
          <span class="text">
            <span class="title">{step.title}&nbsp;<Icon name="right-arrow" class="arrow" /></span>
            <span class="detail">{step.detail}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="more">
    Then browse all the explainers, from DPoP and PAR to SAML and passkeys, in{" "}
    <a href="/protocols/">Protocols: Identity Visualized</a>.
  </p>
</div>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0 -0.5rem;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.5rem;
    border-radius: 0.375rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--duende-color-green-800);
    color: var(--sl-color-white);
  }
  a:hover {
    background-color: var(--dv-active-bg, var(--home-surface));
  }
  a:hover .badge {
    background-color: var(--duende-color-green);
    border-color: var(--duende-color-green);
    color: #212121;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .title {
    font-weight: 600;
    line-height: 1.35;
    color: var(--sl-color-white);
    text-wrap: pretty;
  }
  .detail {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  :global(.home-protocols .arrow) {
    display: inline-block;
    vertical-align: -0.125em;
    color: var(--sl-color-text-accent);
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  a:hover :global(.arrow) {
    transform: translateX(3px);
  }
  .more {
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .more a {
    display: inline;
    padding: 0;
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .more a::before {
    content: none;
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    :global(.home-protocols .arrow) {
      transition: none;
    }
  }
</style>
