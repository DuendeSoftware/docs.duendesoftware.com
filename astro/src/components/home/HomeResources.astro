---
import { Icon } from "@astrojs/starlight/components";

const resources: { href: string; label: string; external?: boolean }[] = [
  { href: "/general/security-best-practices/", label: "Security best practices" },
  { href: "/general/licensing/", label: "Licensing" },
  { href: "/general/glossary/", label: "Glossary" },
  { href: "/general/ai-agent-tools/", label: "AI agent tools and llms.txt" },
];
---

<ul class="home-resources not-content">
  {resources.map((r) => (
    <li>
      <a href={r.href} rel={r.external ? "noopener" : undefined}>
        {r.label}
        {r.external && <><Icon name="external" size="0.875rem" /><span class="sr-only">(opens GitHub)</span></>}
      </a>
    </li>
  ))}
</ul>

<style>
  .home-resources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  a:hover {
    border-color: var(--sl-color-text-accent);
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
