---
import { Icon } from "@astrojs/starlight/components";
import { productIcons } from "virtual:dv-products";
import VersionStatus from "./VersionStatus.astro";

const icons = productIcons as Record<string, string>;
// User Management has no sidebar topic of its own; padlock matches the hero jump list.
const iconFor = (key: string) => icons[key] ?? "padlock";

type Link = { href: string; label: string };
const products: { key: string; name: string; purpose: string; links: Link[]; site?: Link[]; lead?: boolean; oss?: boolean }[] = [
  {
    key: "identityserver",
    name: "IdentityServer",
    purpose:
      "The most flexible and standards-compliant OpenID Connect, OAuth 2.0, and SAML framework for ASP.NET Core. Start here if you need to issue tokens.",
    links: [
      { href: "/identityserver/", label: "Docs" },
      { href: "/identityserver/upgrades/", label: "Upgrade guides" },
      { href: "/identityserver/troubleshooting/", label: "Troubleshooting" },
    ],
    site: [
      { href: "https://duendesoftware.com/products/identityserver", label: "Product page" },
      { href: "https://duendesoftware.com/pricing", label: "Pricing" },
    ],
    lead: true,
  },
  {
    key: "bff",
    name: "Backend-for-Frontend (BFF)",
    purpose:
      "Implement the backend-for-frontend (BFF) pattern to secure SPAs and Blazor WebAssembly apps without storing tokens in the browser.",
    links: [
      { href: "/bff/", label: "Docs" },
      { href: "/bff/upgrading/", label: "Upgrade guides" },
    ],
    site: [
      { href: "https://duendesoftware.com/products/capabilities/backend-for-frontend", label: "Product page" },
      { href: "https://duendesoftware.com/pricing", label: "Pricing" },
    ],
  },
  {
    key: "user-management",
    name: "User Management",
    purpose:
      "Native user storage, passwordless-first authentication, and full lifecycle management for IdentityServer: profiles, roles, groups, and multi-tenancy.",
    links: [{ href: "/identityserver/identity/user-management/", label: "Docs" }],
    site: [
      { href: "https://duendesoftware.com/products/capabilities/user-management", label: "Product page" },
      { href: "https://duendesoftware.com/pricing", label: "Pricing" },
    ],
  },
  {
    key: "accesstokenmanagement",
    name: "Access Token Management",
    purpose: "Automatic caching and refresh of client credentials and user access tokens.",
    links: [{ href: "/accesstokenmanagement/", label: "Docs" }],
    oss: true,
  },
  {
    key: "identitymodel",
    name: "IdentityModel",
    purpose: "Client library for OAuth 2.0 and OpenID Connect protocol operations.",
    links: [{ href: "/identitymodel/", label: "Docs" }],
    oss: true,
  },
  {
    key: "identitymodel-oidcclient",
    name: "OIDC Client",
    purpose: "OpenID Connect client for native and desktop .NET applications.",
    links: [{ href: "/identitymodel-oidcclient/", label: "Docs" }],
    oss: true,
  },
  {
    key: "introspection",
    name: "Introspection for ASP.NET Core",
    purpose: "Authentication handler for OAuth 2.0 token introspection.",
    links: [{ href: "/introspection/", label: "Docs" }],
    oss: true,
  },
];
---

<ul class="home-guide not-content">
  {products.map((p) => (
    <li class:list={{ lead: p.lead }}>
      <div class="what">
        <h3>
          <span class="icon"><Icon name={iconFor(p.key) as any} /></span>
          <a href={p.links[0].href}>{p.name}</a>
          {p.oss && <span class="oss">Open source</span>}
        </h3>
        <p>{p.purpose}</p>
      </div>
      <div class="meta">
        <VersionStatus product={p.key} />
        {p.links.length > 1 && (
          <div class="links">
            {p.links.slice(1).map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        )}
        {p.site && (
          <div class="links site">
            {p.site.map((l) => (
              <a href={l.href} rel="noopener">
                {l.label}<Icon name="external" size="0.8125rem" /><span class="sr-only">(duendesoftware.com)</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </li>
  ))}
</ul>
<p class="home-guide-note not-content">
  The open-source libraries are released under the Apache 2.0 license.{" "}
  <a href="https://duendesoftware.com/products/opensource" rel="noopener">
    Learn more on duendesoftware.com<Icon name="external" size="0.8125rem" /><span class="sr-only">(opens duendesoftware.com)</span>
  </a>
</p>

<style>
  .home-guide {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 18rem);
    gap: 0.75rem 2.5rem;
    margin: 0;
    padding: 1rem 0;
  }
  /* The one reference-style list on the page: hairlines between rows only. */
  li + li {
    border-top: 1px solid var(--sl-color-gray-5);
  }
  @media (max-width: 50rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  li.lead {
    padding-block: 0.25rem 1.5rem;
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.375rem;
    font-family: var(--font-gt-canon), serif;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .lead h3 {
    font-size: 1.625rem;
    letter-spacing: -0.01em;
  }
  .icon {
    flex: none;
    align-self: center;
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: -0.25rem;
    color: var(--sl-color-gray-2);
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .lead .icon {
    width: 1.75rem;
    height: 1.75rem;
  }
  h3 a {
    color: var(--sl-color-white);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .oss {
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
  p {
    margin: 0;
    max-width: 62ch;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-sm);
  }
  .links a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 0.2em;
  }
  /* Links out to the marketing site: same size, muted, marked external. */
  .links.site a,
  .home-guide-note a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-gray-2);
  }
  .links.site a:hover,
  .home-guide-note a:hover {
    color: var(--sl-color-white);
  }
  .home-guide-note {
    max-width: none;
    margin: 0.75rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .home-guide-note a {
    text-underline-offset: 0.2em;
  }
</style>
