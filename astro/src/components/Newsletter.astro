---
import { Icon } from "@astrojs/starlight/components";
---
<section class="hubspot-form-wrapper newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-pitch">
    <p class="newsletter-title" id="newsletter-title">
      <Icon name="email" size="1.25rem" />
      Get the Duende newsletter
    </p>
    <p class="newsletter-subtitle">
      Security best practices, product updates and releases, implementation guides, and industry news.
    </p>
  </div>
  <hubspot-form></hubspot-form>
</section>

<style>
  .newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 1.5rem 3rem;
    align-items: start;
    padding: 1.5rem;
    border: 0 !important;
    border-radius: 12px;
    background: var(--home-surface, var(--sl-color-gray-6));
  }
  @media (max-width: 50rem) {
    .newsletter {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .newsletter-pitch p {
    margin: 0;
  }
  .newsletter-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .newsletter-subtitle {
    margin-top: 0.5rem !important;
    max-width: 40ch;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* HubSpot renders its own markup; lay it out as a compact two-column grid. */
  .newsletter :global(.hs-form) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    margin: 0;
  }
  @media (max-width: 30rem) {
    .newsletter :global(.hs-form) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .newsletter :global(.hs-form fieldset) {
    display: contents;
  }
  .newsletter :global(.hs-form-field) {
    gap: 0.25rem;
    width: auto !important;
    margin: 0;
    float: none !important;
  }
  .newsletter :global(.hs-form-field .input) {
    margin: 0 !important;
  }
  .newsletter :global(.hs-form-field label) {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .newsletter :global(.hs-input) {
    width: 100% !important;
    max-width: none !important;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
  }
  .newsletter :global(.hs-input:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .newsletter :global(.hs_submit),
  .newsletter :global(.legal-consent-container),
  .newsletter :global(.hs_error_rollup) {
    grid-column: 1 / -1;
  }
  .newsletter :global(.hs_submit .actions) {
    margin: 0.25rem 0 0;
  }
  .newsletter :global(.hs-button) {
    padding: 0.625rem 1.25rem;
    border: 0;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font: inherit;
    font-weight: 600;
    font-size: var(--sl-text-sm);
  }
  .newsletter :global(.hs-button:hover) {
    background: var(--sl-color-gray-1);
  }
</style>

<script>
  import "https://js.hsforms.net/forms/embed/v2.js";

  declare const hbspt: { forms: { create: (options: Record<string, string>) => void } };

  class HubspotForm extends HTMLElement {
    constructor() {
      super();

      const div = document.createElement("div");
      div.className = `hubspot-form-${Math.random().toString(36).substring(2, 10)}`;
      this.appendChild(div);

      hbspt.forms.create({
        portalId: "47428297",
        formId: "bdd9b287-d141-46e2-8b1f-90ce29fd262e",
        region: "na1",
        target: `.${div.className}`
      });
    }
  }

  customElements.define("hubspot-form", HubspotForm);
</script>

